---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% if page.layout and page.sitemap != false and page.url != "/404.html" %}
  <url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
{% endif %}{% endfor %}
{% for post in site.posts %}{% unless post.sitemap == false %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc><lastmod>{{ post.updated | default: post.date | date_to_xmlschema }}</lastmod></url>
{% endunless %}{% endfor %}
{% for entry in site.wiki %}{% unless entry.sitemap == false %}
  <url><loc>{{ entry.url | absolute_url | xml_escape }}</loc></url>
{% endunless %}{% endfor %}
</urlset>
